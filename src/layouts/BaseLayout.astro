---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import SEO from "../components/SEO.astro";

const defaultTitle = "David Abundis | Software Developer & Cybersecurity | San Antonio, TX";
const defaultDescription =
  "Portfolio of David Abundis, a CS graduate (TAMU-SA) building full-stack, mobile, and AI-powered apps. Security+ certified.";

// pageTitle: the visible <h1> (unless hideTitle).
// title / description / image: what search engines and link previews show.
const {
  pageTitle,
  hideTitle = false,
  title = defaultTitle,
  description = defaultDescription,
  image,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} />
    <!-- Pages can add extra <head> tags with slot="head" (e.g. structured data) -->
    <slot name="head" />
    <!--
      Pick the theme before the page draws, so it doesn't flash the wrong colors:
      use the saved choice, otherwise follow the device's dark mode setting.
    -->
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "earth" && theme !== "water") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "water" : "earth";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <Header />
    <main>
      {pageTitle && !hideTitle ? <h1>{pageTitle}</h1> : null}
      <slot />
    </main>
    <Footer />
  </body>
</html>
