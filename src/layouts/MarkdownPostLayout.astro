---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;

const date = new Date(frontmatter.pubDate).toISOString().slice(0, 10);

// Each tag links back to the blog page with that tag filled into the Tag search box.
const tagLink = (tag: string) => `/blog/?tag=${encodeURIComponent(tag)}`;
---
<BaseLayout
    pageTitle={frontmatter.title}
    hideTitle
    title={`${frontmatter.title} | David Abundis`}
    description={frontmatter.description}
    image={frontmatter.image?.url}
>
    <!-- max-w-[70ch] keeps lines to a comfortable reading length; mx-auto centers the column -->
    <article class="max-w-[70ch] mx-auto py-8">
        <a href="/blog/" class="link link-primary">&larr; Back to blog</a>

        <h1 class="font-minecraft">{frontmatter.title}</h1>

        <p class="meta">
            <time datetime={date}>{date}</time>
            {frontmatter.author && <span> · {frontmatter.author}</span>}
        </p>

        <p class="description">{frontmatter.description}</p>

        <div class="flex flex-wrap gap-2 mb-8">
            {frontmatter.tags.map((tag: string) => (
                <a
                    href={tagLink(tag)}
                    class="badge badge-lg tag-pill"
                    title={`Show posts tagged ${tag}`}
                >
                    {tag}
                </a>
            ))}
        </div>

        {frontmatter.image && (
            <img
                src={frontmatter.image.url}
                alt={frontmatter.image.alt}
                class="w-full rounded-lg shadow-md mb-8"
            />
        )}

        <div class="post-body">
            <slot />
        </div>
    </article>
</BaseLayout>

<style>
  .meta {
    color: var(--color-secondary);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .description {
    font-size: 1.25rem;
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  /*
    The post text comes from Markdown, so it isn't part of this component's
    scoped styles; :global() lets these rules reach it. Tailwind resets
    headings, lists and links to plain text, so they're restyled here.
  */
  .post-body {
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol),
  .post-body :global(blockquote),
  .post-body :global(pre) {
    margin-bottom: 1.5rem;
  }

  .post-body :global(h2) {
    font-size: 1.75rem;
    font-weight: bold;
    margin: 2.5rem 0 1rem;
  }

  .post-body :global(h3) {
    font-size: 1.375rem;
    font-weight: bold;
    margin: 2rem 0 0.75rem;
  }

  .post-body :global(a) {
    color: var(--color-secondary);
    text-decoration: underline;
  }

  .post-body :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }

  .post-body :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }

  .post-body :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-body :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    font-style: italic;
  }

  .post-body :global(code) {
    background: var(--color-base-300);
    padding: 0.1rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.95em;
  }

  .post-body :global(pre) {
    background: var(--color-neutral);
    color: var(--color-neutral-content);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .post-body :global(pre code) {
    background: none;
    padding: 0;
  }

  .post-body :global(img) {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
</style>
