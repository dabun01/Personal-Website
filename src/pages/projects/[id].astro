---
import BaseLayout from "../../layouts/BaseLayout.astro";
import projectInfo from "../../projectInfo.json";

export function getStaticPaths() {
  return projectInfo.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout pageTitle={project.title} hideTitle>
  <!-- Full-width band: breaks out of main's max-width and top padding -->
  <div
    class="relative left-1/2 w-screen -translate-x-1/2 -mt-4 bg-base-300 py-8 px-4"
  >
    <img
      src={project.image}
      class="mx-auto max-h-144 object-contain rounded-lg shadow-xl"
      alt={project.title}
    />
  </div>

  <h1>{project.title}</h1>

  <a href="/" class="link link-primary">&larr; Back to projects</a>

  <div class="flex flex-wrap items-center gap-2 mt-6">
    <div class="badge badge-primary">{project.category}</div>
    {
      project.tags.map((tag) => (
        <div class="badge badge-outline text-black">{tag}</div>
      ))
    }
  </div>

  <p class="text-lg mt-4 max-w-prose">{project.longDescription}</p>

  <div class="flex flex-wrap gap-3 mt-6 mb-8">
    {
      project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          View Live Site
        </a>
      )
    }
    {
      project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          View on GitHub
        </a>
      )
    }
  </div>
</BaseLayout>
