---
import BaseLayout from "../../layouts/BaseLayout.astro";
import projectInfo from "../../projectInfo.json";
import { categoryColor } from "../../categoryColors";

export function getStaticPaths() {
  return projectInfo.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;

// "FULL STACK" -> "Full Stack Project" for the page title
const categoryLabel = (category: string) =>
  category.toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase()) + " Project";

// Link back to the projects page with this tag pre-filled in the Tag search box.
const tagLink = (tag: string) => `/?tag=${encodeURIComponent(tag)}`;
---

<BaseLayout
  pageTitle={project.title}
  hideTitle
  title={`${project.title} – ${categoryLabel(project.category)} | David Abundis`}
  description={project.description}
  image={project.image}
>
  <!-- Full-width band: breaks out of main's max-width and top padding -->
  <div
    class="relative left-1/2 w-screen -translate-x-1/2 -mt-4 bg-base-300 py-8 px-4"
  >
    <img
      src={project.image}
      class="mx-auto max-h-144 object-contain rounded-lg shadow-xl"
      alt={project.title}
    />
  </div>

  <h1 class="font-minecraft">{project.title}</h1>

  <a href="/" class="link link-primary">&larr; Back to projects</a>

  <div class="flex flex-wrap items-center gap-2 mt-6">
    <a
      href={tagLink(project.category)}
      class={`badge hover:brightness-110 ${categoryColor(project.category)}`}
      title={`Show ${project.category} projects`}
    >
      {project.category}
    </a>
    {
      project.tags.map((tag) => (
        <a
          href={tagLink(tag)}
          class="badge tag-pill"
          title={`Show projects using ${tag}`}
        >
          {tag}
        </a>
      ))
    }
  </div>

  <p class="text-lg mt-4 max-w-prose">{project.longDescription}</p>

  <div class="flex flex-wrap gap-3 mt-6 mb-8">
    {
      project.liveUrl && (
        <a
          href={project.liveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          View Live Site
        </a>
      )
    }
    {
      project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          View on GitHub
        </a>
      )
    }
  </div>
</BaseLayout>
