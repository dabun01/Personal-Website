---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import projectInfo from "../projectInfo.json";

const pageTitle = "My Projects";
const allTags = [...new Set(projectInfo.flatMap((project) => project.tags))].sort();
---

<BaseLayout pageTitle={pageTitle} hideTitle>
  <h1 class="font-minecraft">{pageTitle}</h1>

  <div class="flex flex-col sm:flex-row gap-4 mb-8">
    <label class="input w-full sm:flex-1">
      <span class="label">Name</span>
      <input
        id="project-search"
        type="search"
        placeholder="Search projects by name"
        autocomplete="off"
      />
    </label>
    <label class="input w-full sm:flex-1">
      <span class="label">Tag</span>
      <input
        id="tag-search"
        type="search"
        list="tag-options"
        placeholder="Filter by tag (e.g. Python)"
        autocomplete="off"
      />
    </label>
    <datalist id="tag-options">
      {allTags.map((tag) => <option value={tag} />)}
    </datalist>
  </div>

  <div class="grid gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
    {projectInfo.map((project) => <ProjectCard {...project} />)}
  </div>

  <p id="no-results" class="text-center text-lg mt-8" hidden>
    No projects match your search.
  </p>
</BaseLayout>

<script>
  const nameInput = document.getElementById("project-search") as HTMLInputElement;
  const tagInput = document.getElementById("tag-search") as HTMLInputElement;
  const noResults = document.getElementById("no-results")!;
  const cards = document.querySelectorAll<HTMLElement>("[data-project-card]");
  const tagButtons = document.querySelectorAll<HTMLButtonElement>("[data-tag-filter]");

  // Every tag used by any project, so we can tell a full tag name from a partial one.
  const knownTags = new Set(
    [...cards].flatMap((card) => card.dataset.tags!.split("|"))
  );

  function filterProjects() {
    const name = nameInput.value.trim().toLowerCase();
    const tag = tagInput.value.trim().toLowerCase();
    let visible = 0;

    cards.forEach((card) => {
      const matchesName = card.dataset.title!.includes(name);
      const cardTags = card.dataset.tags!.split("|");
      // A full tag name (e.g. "java") matches exactly, so it won't also match
      // "javascript". Anything else is a partial search.
      const matchesTag =
        !tag ||
        (knownTags.has(tag)
          ? cardTags.includes(tag)
          : cardTags.some((t) => t.includes(tag)));
      const show = matchesName && matchesTag;
      card.hidden = !show;
      if (show) visible++;
    });

    noResults.hidden = visible > 0;
  }

  nameInput.addEventListener("input", filterProjects);
  tagInput.addEventListener("input", filterProjects);

  // Clicking a tag pill puts that tag in the Tag box and re-runs the filter.
  tagButtons.forEach((button) => {
    button.addEventListener("click", () => {
      tagInput.value = button.dataset.tagFilter!;
      filterProjects();
      tagInput.scrollIntoView({ behavior: "smooth", block: "center" });
    });
  });
</script>
