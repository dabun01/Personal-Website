---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "About Me";

const identity = {
  firstname: "David",
  lastname: "Abundis",
  occupation: "IT Help Desk Student Worker",
  location: "San Antonio, Texas",
  hobbies: ["Web Development", "Design", "Basketball"],
  favoriteTeams: ["San Antonio Spurs", "Dallas Cowboys"],
};

const skills = [
  "HTML",
  "CSS",
  "Java",
  "JavaScript",
  "Astro",
  "React",
  "Node.js",
  "Figma",
];
---

<BaseLayout pageTitle={pageTitle}>
  <p>
    Hi, I’m David Abundis a senior at Texas A&M University–San Antonio studying
    Computer Science with a focus on cybersecurity. As a first-generation
    college student, I’m driven by a passion for using technology to create
    meaningful, real-world impact. I’ve been able to sharpen my skills through
    hackathons, CTF competitions, and hands-on projects, constantly pushing
    myself to learn and adapt in the ever-evolving tech landscape.
  </p>

  <p>
    Beyond code, I’m a huge basketball fan (Go Spurs Go), and I love building
    fun, engaging tools for both casual and diehard fans. Whether it’s
    cybersecurity, software development, or creative tech projects, I’m always
    exploring new ways to turn ideas into something impactful and exciting.
  </p>

  <ul>
    {skills.map((skill) => <li class="skill">{skill}</li>)}
  </ul>

  <style is:global>
    h1 {
      color: #6043b0;
      font-size: 3rem;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 0.5rem 0;
    }

    .skill {
      display: inline-block;
      background-color: green;
      color: white;
      padding: 0.5rem 1rem;
      margin: 0.25rem;
      text-decoration: none;
      border-radius: 6px;
      font-weight: bold;
    }
  </style>
</BaseLayout>
