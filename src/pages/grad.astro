---
import BaseLayout from "../layouts/BaseLayout.astro";
import GradInvite from "../components/GradInvite.astro";
---

<BaseLayout>
  <GradInvite />
  <h1 class="text-center" >Graduation Celebration</h1>
  <div class="text-center max-w-md mx-auto">
    
    <p><strong>Date:</strong> May 19th, 2026 at 10:00 AM</p>
    <a href="https://google.com/maps/search/?api=1&query=3201+E+Houston+St%2C+San+Antonio%2C+TX+78219" target="_blank" style="text-decoration: underline; color: blue;">
        Freeman Coliseum, 3201 E Houston St, San Antonio, TX 78219
    </a>
    <p><strong>Parking:</strong> GATE B/LOT 1</p>
    <p><strong>Guests Information:</strong> Doors open one hour before the ceremony. 
    There are no tickets needed and no guest limit. 
    The Freeman Coliseum charges a parking fee of $15 for guests.</p>
  </div>
</BaseLayout>

