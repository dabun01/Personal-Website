---
import "../styles/global.css";
import ThemeToggle from "./ThemeToggle.astro";

const links = [
  { href: "/", label: "Projects" },
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Blog" },
];
---

<!--
  Three-column grid: the two outer columns are always equal width (1fr each),
  so the middle column (the theme toggle) sits exactly in the center on every
  screen size. minmax(0, 1fr) lets the outer columns shrink instead of pushing
  the toggle off-center. On phones the name and toggle are smaller so they fit.
-->
<div class="navbar w-full bg-neutral text-neutral-content shadow-sm grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] gap-2">
  <div class="flex justify-start min-w-0">
    <a href="/landing/" class="btn btn-ghost font-minecraft text-sm min-[400px]:text-base sm:text-xl px-1 sm:px-4 whitespace-nowrap" aria-label="David Abundis">
      <!-- Initials on very narrow phones (under 360px), full name otherwise -->
      <span class="text-base min-[360px]:hidden">DA</span>
      <span class="hidden min-[360px]:inline">David Abundis</span>
    </a>
  </div>
  <div class="flex justify-center">
    <ThemeToggle />
  </div>
  <div class="flex justify-end min-w-0">
    <!-- Medium screens and up: links in a row -->
    <ul class="menu menu-horizontal px-1 hidden md:flex font-minecraft">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>

    <!--
      Small screens: menu button with a dropdown. daisyUI's dropdown opens
      while the button (or the list) has focus, and closes when you tap elsewhere.
    -->
    <div class="dropdown dropdown-end md:hidden">
      <div tabindex="0" role="button" class="btn btn-ghost btn-square" aria-label="Open menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </div>
      <ul
        tabindex="0"
        class="menu dropdown-content font-minecraft bg-neutral text-neutral-content rounded-box z-50 mt-3 w-40 p-2 shadow-lg"
      >
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </div>
  </div>
</div>
