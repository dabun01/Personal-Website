---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import hero from "../assets/images/hero.png";

interface Props {
  title: string;
  description: string;
  // An imported image (optimized below) or a URL string (e.g. a post's remote image)
  image?: ImageMetadata | string;
}
// TODO: replace the default with a 1200x630 image made for link previews.
const { title, description, image = hero } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Link previews: a 1200px-wide JPG, which LinkedIn, Slack, iMessage, etc. all support.
const ogSrc =
  typeof image === "string"
    ? image
    : (await getImage({ src: image, width: 1200, format: "jpg" })).src;
const ogImage = new URL(ogSrc, Astro.site);
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Link previews on LinkedIn, Slack, Discord, iMessage -->
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />