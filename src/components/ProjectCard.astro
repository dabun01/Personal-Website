---
import "../styles/global.css";
import { categoryColor } from "../categoryColors";

const { id, title, description, image, tags, category } = Astro.props;
---

<!--
  The card is an <article>, not a link, because the tag pills are buttons and
  a button isn't allowed inside a link. The title link's ::after is stretched
  over the whole card (after:absolute after:inset-0) so the card is still
  clickable anywhere; the pills sit above it (relative z-10) to get their own clicks.
-->
<article
  data-filter-card
  data-title={title.toLowerCase()}
  data-tags={[category, ...tags].join("|").toLowerCase()}
  class="card-xs relative bg-white w-full shadow-xl overflow-hidden transition hover:-translate-y-1 hover:shadow-2xl"
>
  <figure class="h-48 overflow-hidden">
    <img
      src={image}
      class="w-full h-full object-cover object-top"
      alt={title}
    />
  </figure>
  <div class="card-body">
    <h2 class="card-title text-2xl text-black">
      <a
        href={`/projects/${id}/`}
        class="font-minecraft after:absolute after:inset-0"
      >
        {title}
      </a>
    </h2>
    <div class="card-actions justify-start">
      <button
        type="button"
        data-tag-filter={category}
        class={`badge relative z-10 cursor-pointer hover:brightness-110 ${categoryColor(category)}`}
        title={`Show ${category} projects`}
      >
        {category}
      </button>
      {
        tags.map((tag: string) => (
          <button
            type="button"
            data-tag-filter={tag}
            class="badge relative z-10 cursor-pointer bg-gray-200 border-gray-300 text-black hover:bg-gray-300"
            title={`Show projects using ${tag}`}
          >
            {tag}
          </button>
        ))
      }
    </div>
    <p class="text-base">{description}</p>
  </div>
</article>
