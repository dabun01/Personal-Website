---
import "../styles/global.css";

const { id, title, description, image, tags, category } = Astro.props;
---

<a
  href={`/projects/${id}/`}
  class="card-xs bg-white w-full shadow-xl overflow-hidden block transition hover:-translate-y-1 hover:shadow-2xl"
>
  <figure class="h-48 overflow-hidden">
    <img
      src={image}
      class="w-full h-full object-cover object-top"
      alt={title}
    />
  </figure>
  <div class="card-body">
    <h2 class="card-title text-2xl text-black">
      {title}
      <div class="badge badge-primary badge-sm">{category}</div>
    </h2>
    <p>{description}</p>
    <div class="card-actions justify-start">
      {
        tags.map((tag: unknown) => (
          <div class="badge badge-outline text-black">{tag}</div>
        ))
      }
    </div>
  </div>
</a>
