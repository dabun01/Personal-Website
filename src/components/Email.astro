---
const { username, domain } = Astro.props;

// Envelope icon from Bootstrap Icons (MIT); it uses the link's text color.
const envelope =
  "M.05 3.555A2 2 0 0 1 2 2h12a2 2 0 0 1 1.95 1.555L8 8.414zM0 4.697v7.104l5.803-3.558zM6.761 8.83l-6.57 4.027A2 2 0 0 0 2 14h12a2 2 0 0 0 1.808-1.144l-6.57-4.027L8 9.586zm3.436-.586L16 11.801V4.697z";
---

<a class="social-link" href={`mailto:${username}@${domain}`} aria-label="email">
  <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
    <path d={envelope} />
  </svg>
</a>
